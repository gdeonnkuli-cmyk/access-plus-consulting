rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════════
// Règles Firestore — Éco-Campus RDC (Access Plus Consulting)
// Rôles : administrateur (admin@accessplus.com), formateur (users/{uid}.role == "formateur"),
// apprenant (tout autre compte connecté). Toute collection non listée ici est refusée.
// ══════════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions communes ─────────────────────────────────────────────────────
    function connecte() { return request.auth != null; }
    function moi(uid) { return connecte() && request.auth.uid == uid; }
    function estAdmin() { return connecte() && request.auth.token.email == "admin@accessplus.com"; }
    function estFormateur() {
      return connecte() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "formateur";
    }
    function estStaff() { return estAdmin() || estFormateur(); }
    function champsModifies() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function nouveau() { return request.resource.data; }

    // ── Utilisateurs ────────────────────────────────────────────────────────────
    // Un apprenant ne peut s'attribuer l'abonnement « actif » que si l'administrateur lui a déjà
    // délivré un code (activationCode), ni le rôle formateur sans code formateur (formateurCode).
    function abonnementAutorise() {
      let avant = resource.data.get("abonnement", "aucun");
      let apres = nouveau().get("abonnement", "aucun");
      return apres == avant
        || apres in ["demande", "expiré"]
        || (apres == "actif" && resource.data.get("activationCode", null) is string && nouveau().get("codeValide", false) == true);
    }
    function roleAutorise() {
      let avant = resource.data.get("role", null);
      let apres = nouveau().get("role", null);
      return apres == avant || (apres == "formateur" && resource.data.get("formateurCode", null) is string);
    }
    function inscriptionValide() {
      return nouveau().get("abonnement", "aucun") == "aucun"
        && nouveau().get("activationCode", null) == null
        && nouveau().get("codeValide", false) == false
        && nouveau().get("dateExpiration", null) == null
        && !("role" in nouveau())
        && !("formateurCode" in nouveau());
    }
    // Préférences personnelles (page Paramètres)
    function preferencesValides() {
      let p = nouveau().get("preferences", {});
      return p is map && p.keys().hasOnly(["delaiDeco", "taille", "notifEmails"])
        && (!("delaiDeco" in p) || p.delaiDeco in [10, 20, 30, 60])
        && (!("taille" in p) || p.taille in ["normale", "grande", "tres"])
        && (!("notifEmails" in p) || p.notifEmails is bool);
    }
    // Demande d'accès : offre choisie (m, t, a), référence et numéro de la transaction Mobile Money
    function texteCourt(v, n) { return v == null || (v is string && v.size() <= n); }
    function demandeValide() {
      return nouveau().get("demandeOffre", null) in [null, "m", "t", "a"]
        && texteCourt(nouveau().get("demandeRef", null), 60)
        && texteCourt(nouveau().get("demandeTel", null), 30);
    }
    // Date « AAAA-MM-JJ » d'un horodatage (comparaison lexicographique avec une date ISO)
    function jourIso(t) {
      return string(t.year()) + "-" + (t.month() < 10 ? "0" : "") + string(t.month())
        + "-" + (t.day() < 10 ? "0" : "") + string(t.day());
    }
    // Code offert (bons/{code}) : l'utilisateur s'active lui-même, dans le même lot d'écritures
    // qui marque le bon comme utilisé par lui ; la durée est celle du bon, comptée à partir d'aujourd'hui.
    function reclamationBon() {
      let code = nouveau().get("bonCode", "");
      let chemin = /databases/$(database)/documents/bons/$(code);
      let bon = get(chemin).data;
      let exp = nouveau().get("dateExpiration", "");
      return code is string && code.matches("OF-[A-Z0-9]{8}")
        && bon.get("uid", null) == null
        && getAfter(chemin).data.get("uid", null) == request.auth.uid
        && nouveau().get("abonnement", "") == "actif" && nouveau().get("codeValide", false) == true
        && nouveau().get("activationCode", "") == code && nouveau().get("dureeId", "") == bon.dureeId
        && exp is string && exp.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z")
        && exp < jourIso(request.time + duration.value(bon.jours + 1, "d"));
    }
    match /users/{uid} {
      allow read: if moi(uid) || estStaff();
      allow create: if estAdmin() || (moi(uid) && inscriptionValide());
      allow update: if estAdmin()
        // correction des évaluations par un formateur
        || (estFormateur() && champsModifies().hasOnly(["progress", "scores"]))
        // modifications par l'utilisateur lui-même
        || (moi(uid)
            && champsModifies().hasOnly(["nom", "lastLogin", "onboardingDone", "progress", "scores", "abonnement", "demandeDate",
                                         "codeValide", "role", "formateurCodeValide", "consentDate", "consentVersion",
                                         "tel", "province", "ville", "preferences", "demandeOffre", "demandeRef", "demandeTel"])
            && abonnementAutorise() && roleAutorise() && preferencesValides() && demandeValide())
        // activation par un code offert
        || (moi(uid)
            && champsModifies().hasOnly(["abonnement", "codeValide", "activationCode", "dureeId", "dateExpiration", "bonCode"])
            && reclamationBon());
      allow delete: if estAdmin();
    }

    // ── Contenus pédagogiques ───────────────────────────────────────────────────
    // Un formateur crée et modifie ses propres contenus en brouillon ou en attente ; seul
    // l'administrateur publie (status "approved", on: true).
    function contenuFormateurValide() {
      return estFormateur()
        && nouveau().get("createdBy", "") == request.auth.uid
        && nouveau().get("status", "draft") in ["draft", "pending"]
        && nouveau().get("on", false) == false;
    }
    function supprimableParFormateur() {
      return estFormateur() && resource.data.get("createdBy", "") == request.auth.uid && resource.data.get("status", "draft") != "approved";
    }
    match /modules/{id} {
      allow read: if connecte();
      allow create: if estAdmin() || contenuFormateurValide();
      allow update: if estAdmin() || (contenuFormateurValide() && resource.data.get("createdBy", "") == request.auth.uid);
      allow delete: if estAdmin() || supprimableParFormateur();

      // Notes et avis des apprenants : un document par apprenant
      match /ratings/{uid} {
        allow read: if connecte();
        allow create, update: if moi(uid) && nouveau().get("uid", "") == uid;
        allow delete: if moi(uid) || estAdmin();
      }
    }
    match /videos/{id} {
      allow read: if connecte();
      allow create: if estAdmin() || contenuFormateurValide();
      allow update: if estAdmin() || (contenuFormateurValide() && resource.data.get("createdBy", "") == request.auth.uid);
      allow delete: if estAdmin() || supprimableParFormateur();
    }
    match /presentations/{id} {
      allow read: if connecte();
      allow create: if estAdmin() || contenuFormateurValide();
      allow update: if estAdmin() || (contenuFormateurValide() && resource.data.get("createdBy", "") == request.auth.uid);
      allow delete: if estAdmin() || supprimableParFormateur();
    }
    // Documents déposés par les formateurs (validés par l'administrateur)
    match /documents/{id} {
      allow read: if estAdmin() || (connecte() && resource.data.get("createdBy", "") == request.auth.uid);
      allow create: if estAdmin() || (estFormateur() && nouveau().get("createdBy", "") == request.auth.uid && nouveau().get("status", "draft") == "draft");
      allow update: if estAdmin()
        || (estFormateur() && resource.data.get("createdBy", "") == request.auth.uid
            && nouveau().get("createdBy", "") == request.auth.uid && nouveau().get("status", "draft") in ["draft", "pending"]);
      allow delete: if estAdmin() || supprimableParFormateur();
    }

    // Catalogue géré par l'administrateur, lisible par tous les connectés
    match /stages/{id}      { allow read: if connecte(); allow write: if estAdmin(); }
    match /plateformes/{id} { allow read: if connecte(); allow write: if estAdmin(); }
    match /annonces/{id}    { allow read: if connecte(); allow write: if estAdmin(); }
    match /pdfs/{id}        { allow read: if connecte(); allow write: if estAdmin(); }
    match /config/{id}      { allow read: if connecte(); allow write: if estAdmin(); }
    match /presences/{id}   { allow read, write: if estAdmin(); }

    // ── Échanges et évaluations ─────────────────────────────────────────────────
    match /messages/{id} {
      allow read: if estAdmin()
        || (connecte() && (resource.data.get("apprenantUid", "") == request.auth.uid || resource.data.get("formateurUid", "") == request.auth.uid));
      allow create: if estAdmin()
        || (connecte() && nouveau().get("from", "") == request.auth.uid
            && (nouveau().get("apprenantUid", "") == request.auth.uid || (estFormateur() && nouveau().get("formateurUid", "") == request.auth.uid)));
      allow update: if estAdmin()
        || (connecte() && resource.data.get("apprenantUid", "") == request.auth.uid && champsModifies().hasOnly(["luApprenant"]))
        || (connecte() && resource.data.get("formateurUid", "") == request.auth.uid && champsModifies().hasOnly(["luAdmin"]));
      allow delete: if estAdmin();
    }
    // Copies des évaluations à réponses ouvertes
    match /openAnswers/{id} {
      allow read: if estAdmin()
        || (connecte() && (resource.data.get("apprenantUid", "") == request.auth.uid || resource.data.get("formateurUid", "") == request.auth.uid));
      allow create: if connecte() && nouveau().get("apprenantUid", "") == request.auth.uid && nouveau().get("graded", false) == false;
      allow update: if estAdmin()
        || (connecte() && resource.data.get("formateurUid", "") == request.auth.uid
            && champsModifies().hasOnly(["graded", "notes", "totalPoints", "pct", "gradedAt"]));
      allow delete: if estAdmin();
    }
    match /psychoScores/{id} {
      allow read: if estAdmin() || (connecte() && resource.data.get("uid", "") == request.auth.uid);
      allow create: if connecte() && nouveau().get("uid", "") == request.auth.uid;
      allow update, delete: if estAdmin();
    }
    // Demandes de services : créées par les connectés, traitées par l'administrateur
    match /demandes/{id} {
      allow create: if connecte();
      allow read, update, delete: if estAdmin();
    }

    // ── Atelier États financiers SYSCOHADA ──────────────────────────────────────
    match /ef_dossiers/{dossierId} {
      allow read: if connecte() && (request.auth.uid in resource.data.membres || estStaff());
      allow create: if connecte() && nouveau().ownerUid == request.auth.uid && request.auth.uid in nouveau().membres;
      allow update: if connecte() && (request.auth.uid in resource.data.membres || estStaff())
        && nouveau().ownerUid == resource.data.ownerUid;
      allow delete: if connecte() && (resource.data.ownerUid == request.auth.uid || estStaff());
    }
    // Annuaire des invitations : une fiche par e-mail, lisible seulement par son e-mail exact
    match /ef_annuaire/{mail} {
      allow get: if connecte();
      allow list: if false;
      allow create, update: if connecte() && request.auth.token.email != null
        && mail == request.auth.token.email.lower()
        && nouveau().uid == request.auth.uid
        && nouveau().keys().hasOnly(["uid", "nom", "mail", "maj"]);
      allow delete: if connecte() && resource.data.uid == request.auth.uid;
    }

    // ── Audit : présence en ligne et journal des connexions ─────────────────────
    // Chaque compte écrit uniquement sa propre activité ; seul l'administrateur peut lire.
    function roleDeclareValide() {
      return nouveau().role == "apprenant"
        || (nouveau().role == "formateur" && estFormateur())
        || (nouveau().role == "admin" && estAdmin());
    }
    match /activite/{uid} {
      allow read: if estAdmin() || moi(uid);
      allow create, update: if moi(uid)
        && nouveau().keys().hasOnly(["uid", "nom", "mail", "role", "vue", "appareil", "enLigne", "lastSeen", "recents"])
        && nouveau().get("recents", []) is list && nouveau().get("recents", []).size() <= 10
        && nouveau().uid == uid
        && nouveau().lastSeen == request.time
        && roleDeclareValide();
      allow delete: if estAdmin();
    }
    match /connexions/{id} {
      allow read, delete: if estAdmin();
      allow create: if connecte()
        && nouveau().keys().hasOnly(["uid", "nom", "mail", "role", "appareil", "ts"])
        && nouveau().uid == request.auth.uid
        && nouveau().ts == request.time
        && roleDeclareValide();
      allow update: if false;
    }

    // ── Notifications (cloche de l'application) ─────────────────────────────────
    // dest : uid d'un destinataire, ou groupe « all », « apprenants », « formateurs », « admin ».
    // L'administrateur envoie à tous ; un formateur à une personne (corrections, messages, contenus) ;
    // un apprenant seulement à l'administration ou à un formateur (message, suggestion).
    function notifValide() {
      return nouveau().keys().hasOnly(["dest", "type", "titre", "texte", "vue", "ts", "auteur", "auteurNom"])
        && nouveau().auteur == request.auth.uid
        && nouveau().ts == request.time
        && nouveau().titre is string && nouveau().titre.size() > 0 && nouveau().titre.size() <= 120
        && nouveau().get("texte", "") is string && nouveau().get("texte", "").size() <= 1000
        && nouveau().get("vue", "") is string && nouveau().get("vue", "").size() <= 40
        && nouveau().dest is string && nouveau().dest.size() > 0 && nouveau().dest.size() <= 128;
    }
    function destGroupe(d) { return d in ["all", "apprenants", "formateurs", "admin"]; }
    match /notifications/{id} {
      allow read: if estAdmin()
        || (connecte() && (resource.data.dest == request.auth.uid || resource.data.dest in ["all", "apprenants", "formateurs"]));
      allow create: if notifValide() && (
        estAdmin()
        || (estFormateur() && !destGroupe(nouveau().dest) && nouveau().type in ["correction", "message", "contenu", "info"])
        || (connecte() && nouveau().type in ["message", "suggestion"]
            && (nouveau().dest == "admin"
                || get(/databases/$(database)/documents/users/$(nouveau().dest)).data.get("role", "") == "formateur")));
      allow update: if false;
      allow delete: if estAdmin();
    }
    // État de lecture propre à chaque utilisateur : vu (date en ms) et notifications lues une à une
    match /notifEtat/{uid} {
      allow read: if moi(uid);
      allow create, update: if moi(uid)
        && nouveau().keys().hasOnly(["vu", "lues"])
        && nouveau().get("vu", 0) is number
        && nouveau().get("lues", {}) is map && nouveau().get("lues", {}).size() <= 200;
      allow delete: if moi(uid) || estAdmin();
    }
    // Jetons de notification push (Firebase Cloud Messaging) : un document par appareil.
    // Lus uniquement par le serveur d'envoi (api/push, SDK Admin) ; jamais par les autres utilisateurs.
    match /pushTokens/{token} {
      allow read: if estAdmin() || (connecte() && resource.data.uid == request.auth.uid);
      allow create, update: if connecte()
        && nouveau().keys().hasOnly(["uid", "role", "ts", "appareil"])
        && nouveau().uid == request.auth.uid
        && nouveau().ts == request.time
        && roleDeclareValide();
      allow delete: if estAdmin() || (connecte() && resource.data.uid == request.auth.uid);
    }

    // ── Codes d'accès offerts ───────────────────────────────────────────────────
    // Créés par l'administrateur ; connaître le code permet de le lire et de le réclamer une seule fois.
    match /bons/{code} {
      allow get: if connecte();
      allow list, create, delete: if estAdmin();
      allow update: if estAdmin()
        || (connecte()
            && resource.data.get("uid", null) == null
            && champsModifies().hasOnly(["uid", "nom", "utiliseLe"])
            && nouveau().uid == request.auth.uid
            && nouveau().utiliseLe == request.time
            && texteCourt(nouveau().get("nom", null), 120)
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("bonCode", null) == code);
    }

    // ── Boîte à suggestions ─────────────────────────────────────────────────────
    match /suggestions/{id} {
      allow read: if estAdmin() || (connecte() && resource.data.uid == request.auth.uid);
      allow create: if connecte()
        && nouveau().keys().hasOnly(["uid", "nom", "mail", "role", "cat", "texte", "ts", "statut"])
        && nouveau().uid == request.auth.uid
        && nouveau().ts == request.time
        && nouveau().statut == "nouveau"
        && nouveau().cat in ["idee", "bug", "contenu", "autre"]
        && nouveau().texte is string && nouveau().texte.size() >= 5 && nouveau().texte.size() <= 2000
        && roleDeclareValide();
      allow update: if estAdmin()
        && champsModifies().hasOnly(["statut", "reponse", "reponseTs"])
        && nouveau().statut in ["nouveau", "en_cours", "realise", "rejete"]
        && nouveau().get("reponse", "") is string && nouveau().get("reponse", "").size() <= 2000;
      allow delete: if estAdmin();
    }

    // ── Attestations (délivrées uniquement par le serveur : api/attestation.js) ─
    // Lecture d'un numéro pour tous (page publique de vérification) ; liste réservée au titulaire et à l'admin ;
    // l'admin ne peut que révoquer ou rétablir.
    match /attestations/{numero} {
      allow get: if true;
      allow list: if estAdmin() || (connecte() && resource.data.uid == request.auth.uid);
      allow update: if estAdmin()
        && champsModifies().hasOnly(["statut", "revoqueLe", "motif"])
        && nouveau().statut in ["valide", "revoquee"]
        && texteCourt(nouveau().get("motif", null), 300);
      allow create, delete: if false;
    }
  }
}
